# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# n8n Webhook — usato per la generazione AI di CV e Cover Letter
# Formato: https://your-n8n.cloud/webhook/career-vault/generate
# Lascia vuoto finché il workflow n8n non è configurato.
EXPO_PUBLIC_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/career-vault
EXPO_PUBLIC_N8N_IMPORT_WEBHOOK_URL=https://your-n8n-instance.com/webhook/import-pdf
# Shared secret between app and n8n to authenticate webhook requests
EXPO_PUBLIC_N8N_WEBHOOK_SECRET=
