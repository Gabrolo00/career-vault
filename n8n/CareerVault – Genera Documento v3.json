    {
      "parameters": {
        "jsCode": "const allItems=$input.all();\nconst cfg=$('Config').first().json;\nconst{userId,docType,jobDescription,documentId,openaiKey,supabaseUrl,supabaseKey}=cfg;\nconst first=allItems[0]?.json;\nconst experiences=Array.isArray(first)?first:allItems.map(i=>i.json).filter(e=>e&&e.title);\nconst expText=experiences.length===0?'(Nessuna esperienza)':experiences.map(e=>{\n  const range=e.is_current?`${e.start_date||'?'} – Presente`:`${e.start_date||'?'} – ${e.end_date||'?'}`;\n  return`[${(e.type||'work').toUpperCase()}] ${e.title} @ ${e.organization||'N/A'} (${range})${e.description?'\\n  '+e.description.slice(0,300):''}`;\n}).join('\\n\\n');\nconst isCV=docType==='cv';\nconst systemPrompt='Sei un esperto career coach italiano. Scrivi un '+(isCV?'Curriculum Vitae':'Lettera di Presentazione')+' professionale ATS-friendly in HTML semantico puro (senza html/head/body).';\nconst userPrompt=isCV?'ESPERIENZE:\\n'+expText+'\\n\\nJOB DESCRIPTION:\\n'+jobDescription+'\\n\\nCrea CV: Profilo, Esperienze, Competenze.'\n:'ESPERIENZE:\\n'+expText+'\\n\\nJOB DESCRIPTION:\\n'+jobDescription+'\\n\\nLettera motivazionale 3 paragrafi.';\nreturn[{json:{userId,docType,jobDescription,documentId,openaiKey,supabaseUrl,supabaseKey,systemPrompt,userPrompt}}];"
      },
      "id": "93add439-43e4-49e2-969f-8519584f9ca1",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        -416
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.openaiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'gpt-4o-mini', messages: [{ role: 'system', content: $json.systemPrompt }, { role: 'user', content: $json.userPrompt }], temperature: 0.7, max_tokens: 3000 } }}",
        "options": {}
      },
      "id": "ae921bd7-13f8-44c9-b4bd-353614366576",
      "name": "OpenAI Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3072,
        -416
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiContent = $input.first().json.choices[0].message.content;\nconst pd = $('Build Prompt').first().json;\nconst { userId, docType, jobDescription, documentId, supabaseUrl, supabaseKey } = pd;\nconst label = docType === 'cv' ? 'Curriculum Vitae' : 'Lettera di Presentazione';\nconst filename = `${docType}-${userId}-${Date.now()}.html`;\nconst html = `<!DOCTYPE html><html lang='it'><head><meta charset='UTF-8'><title>${label}</title><style>body{font-family:Arial,sans-serif;max-width:820px;margin:0 auto;padding:48px;color:#1a1a2e;line-height:1.7}h1,h2,h3{color:#6366f1}h1{font-size:24px;border-bottom:2px solid #6366f1;padding-bottom:8px}h2{font-size:16px;margin-top:24px}ul{padding-left:18px}section{padding:14px;background:#f8f8ff;border-left:3px solid #6366f1;border-radius:0 8px 8px 0;margin-bottom:16px}</style></head><body><p style='color:#94a3b8;font-size:11px;margin-bottom:20px'>CareerVault · ${new Date().toLocaleDateString('it-IT')}</p>${aiContent}</body></html>`;\nreturn [{ json: { userId, docType, jobDescription, documentId, supabaseUrl, supabaseKey, html, filename } }];"
      },
